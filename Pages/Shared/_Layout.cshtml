<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LogísticaPro</title>
    <!-- Bootstrap CSS Local -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons (Ícones minimalistas em preto/branco/cinza) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- CSS Customizado -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light-gray">
    <div class="d-flex min-vh-100">
        <!-- Sidebar Lateral Preta / Escala de Cinza -->
        <aside class="sidebar bg-black text-white d-flex flex-column p-3">
            <a asp-page="/Index" class="d-flex align-items-center mb-4 text-white text-decoration-none border-bottom border-secondary pb-3">
                <i class="bi bi-truck fs-4 me-2 text-white"></i>
                <span class="fs-5 fw-bold tracking-tight">Logística<span class="text-secondary">Pro</span></span>
            </a>

            <ul class="nav nav-pills flex-column mb-auto gap-1">
                <li class="nav-item">
                    <a asp-page="/Index" class="nav-link sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-page="/ProdutoPages/Index" class="nav-link sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Produto") == true ? "active" : "")">
                        <i class="bi bi-box-seam me-2"></i> Produtos
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-page="/FornecedorPages/Index" class="nav-link sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Fornecedor") == true ? "active" : "")">
                        <i class="bi bi-building me-2"></i> Fornecedores
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-page="/PedidoPages/Index" class="nav-link sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Pedido") == true ? "active" : "")">
                        <i class="bi bi-clipboard-check me-2"></i> Pedidos
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-page="/EntregaPages/Index" class="nav-link sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Entrega") == true ? "active" : "")">
                        <i class="bi bi-geo-alt me-2"></i> Entregas
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-page="/Relatorios/Index" class="nav-link sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Relatorios") == true ? "active" : "")">
                        <i class="bi bi-bar-chart-line me-2"></i> Relatórios
                    </a>
                </li>
            </ul>

            <div class="border-top border-secondary pt-3 mt-auto">
                <div class="d-flex align-items-center text-secondary small">
                    <i class="bi bi-person-circle fs-5 me-2 text-white"></i>
                    <div>
                        <div class="text-white fw-semibold">Administrador</div>
                        <div style="font-size: 0.75rem;">Acesso Total</div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Conteúdo Principal -->
        <div class="flex-grow-1 d-flex flex-column">
            <!-- Barra Superior Branca -->
            <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-semibold text-dark">@ViewData["Title"]</h5>
                <span class="badge bg-dark text-white px-3 py-2 rounded-pill">
                    <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
                </span>
            </header>

            <!-- Corpo da Página -->
            <main role="main" class="p-4 flex-grow-1">
                @RenderBody()
            </main>

            <!-- Rodapé Discreto -->
            <footer class="bg-white border-top py-3 px-4 text-muted small d-flex justify-content-between">
                <span>&copy; 2026 - <strong>Sistema Logístico</strong> | Solução de Gestão de Logística e Estoque</span>
                <span>v1.0</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>