@page
@model Sistema_Logistico.Pages.EntregaPages.DetailsModel
@{
    ViewData["Title"] = "Detalhes da Entrega";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold text-dark mb-1">Detalhes da Entrega</h3>
                    <p class="text-muted small mb-0">Informações de destino, agendamento e status da rota.</p>
                </div>
                <a asp-page="./Index" class="btn-mono-secondary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Voltar para Lista
                </a>
            </div>

            <div class="form-card">
                <div class="row g-4">
                    <div class="col-md-12">
                        <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Destino</span>
                        <span class="fs-5 fw-bold text-dark">@Model.Entrega.Destino</span>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Data e Hora Prevista</span>
                        <span class="fw-medium text-dark">@Model.Entrega.DataEntrega.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Status</span>
                        <span class="badge @(Model.Entrega.Status == "Entregue" ? "bg-dark text-white" : "bg-light text-dark border") px-3 py-2">
                            @Model.Entrega.Status
                        </span>
                    </div>
                </div>

                <hr class="my-4 text-muted opacity-25">

                <div class="d-flex justify-content-end gap-2">
                    <a asp-page="./Index" class="btn-mono-secondary">Voltar</a>
                    <a asp-page="./Edit" asp-route-id="@Model.Entrega.Id" class="btn-mono-primary d-inline-flex align-items-center gap-2">
                        <i class="bi bi-pencil"></i> Editar Entrega
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>