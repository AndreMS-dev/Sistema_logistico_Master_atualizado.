@page
@model Sistema_Logistico.Pages.EntregaPages.CreateModel
@{
    ViewData["Title"] = "Nova Entrega";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            
            <!-- Cabeçalho da Página -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold text-dark mb-1">Registrar Entrega</h3>
                    <p class="text-muted small mb-0">Informe o destino, previsão e status da movimentação.</p>
                </div>
                <a asp-page="Index" class="btn-mono-secondary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Voltar para Lista
                </a>
            </div>

            <!-- Card do Formulário -->
            <div class="form-card">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-dark py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Entrega.Destino" class="form-label">Destino <span class="text-danger">*</span></label>
                            <input asp-for="Entrega.Destino" class="form-control" placeholder="Ex: Centro de Distribuição - São Paulo/SP" />
                            <span asp-validation-for="Entrega.Destino" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Entrega.DataEntrega" class="form-label">Data e Hora da Entrega <span class="text-danger">*</span></label>
                            <input asp-for="Entrega.DataEntrega" class="form-control" />
                            <span asp-validation-for="Entrega.DataEntrega" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Entrega.Status" class="form-label">Status <span class="text-danger">*</span></label>
                            <select asp-for="Entrega.Status" class="form-select">
                                <option value="">Selecione o status...</option>
                                <option value="Pendente">Pendente</option>
                                <option value="Em Rota">Em Rota</option>
                                <option value="Entregue">Entregue</option>
                                <option value="Cancelada">Cancelada</option>
                            </select>
                            <span asp-validation-for="Entrega.Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4 text-muted opacity-25">

                    <!-- Rodapé de Ações -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="Index" class="btn-mono-secondary">Cancelar</a>
                        <button type="submit" class="btn-mono-primary d-inline-flex align-items-center gap-2">
                            <i class="bi bi-check-lg"></i> Salvar Entrega
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}