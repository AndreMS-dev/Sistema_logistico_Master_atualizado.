@page
@model Sistema_Logistico.Pages.PedidoPages.IndexModel
@{
    ViewData["Title"] = "Pedidos";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Controle de Pedidos</h3>
            <p class="text-muted small mb-0">Acompanhe os pedidos registrados e seus status.</p>
        </div>
        <a asp-page="Create" class="btn-mono-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i> Novo Pedido
        </a>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Cliente</th>
                        <th>Data do Pedido</th>
                        <th>Status</th>
                        <th>Valor Total</th>
                        <th class="text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Pedido)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">@item.Cliente</td>
                            <td class="text-secondary">@item.DataPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge @(item.Status == "Entregue" ? "bg-dark text-white" : "bg-light text-dark border")">
                                    @item.Status
                                </span>
                            </td>
                            <td class="fw-medium">@item.ValorTotal.ToString("C")</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-dark" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Detalhes"><i class="bi bi-eye"></i></a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-dark" title="Excluir"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>