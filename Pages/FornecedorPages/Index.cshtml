@page
@model Sistema_Logistico.Pages.FornecedorPages.IndexModel
@{
    ViewData["Title"] = "Fornecedores";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Fornecedores Cadastrados</h3>
            <p class="text-muted small mb-0">Gerencie os contatos dos parceiros comerciais.</p>
        </div>
        <a asp-page="Create" class="btn-mono-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i> Novo Fornecedor
        </a>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Nome</th>
                        <th>Telefone</th>
                        <th>E-mail</th>
                        <th class="text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Fornecedor)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">@item.Nome</td>
                            <td class="text-secondary">@item.Telefone</td>
                            <td class="text-secondary">@item.Email</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-dark" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Detalhes"><i class="bi bi-eye"></i></a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-dark" title="Excluir"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>