@page
@model Sistema_Logistico.Pages.ProdutoPages.IndexModel
@{
    ViewData["Title"] = "Produtos";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Catálogo de Produtos</h3>
            <p class="text-muted small mb-0">Gerencie os itens disponíveis e acompanhe o nível de estoque.</p>
        </div>
        <a asp-page="Create" class="btn-mono-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i> Novo Produto
        </a>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Produto</th>
                        <th>Categoria</th>
                        <th>Estoque</th>
                        <th>Preço Unitário</th>
                        <th class="text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Produto)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">@item.Nome</td>
                            <td><span class="badge bg-light text-dark border">@item.Categoria</span></td>
                            <td>
                                @if (item.QuantidadeEstoque <= 5)
                                {
                                    <span class="badge bg-dark text-white">@item.QuantidadeEstoque un. (Crítico)</span>
                                }
                                else
                                {
                                    <span class="text-secondary fw-medium">@item.QuantidadeEstoque un.</span>
                                }
                            </td>
                            <td class="fw-medium">@item.Preco.ToString("C")</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-dark" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Detalhes"><i class="bi bi-eye"></i></a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-dark" title="Excluir"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>