@page
@model Sistema_Logistico.Pages.ProdutoPages.DeleteModel
@{
    ViewData["Title"] = "Excluir Produto";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold text-dark mb-1">Excluir Produto</h3>
                    <p class="text-muted small mb-0">Confirme a remoção permanente deste item do catálogo.</p>
                </div>
                <a asp-page="./Index" class="btn-mono-secondary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Voltar para Lista
                </a>
            </div>

            <div class="form-card">
                <div class="bg-dark text-white rounded-3 p-3 mb-4 d-flex align-items-center gap-3">
                    <i class="bi bi-exclamation-triangle fs-4"></i>
                    <div class="small">
                        <strong>Atenção:</strong> Esta ação não poderá ser desfeita. Deseja realmente excluir este produto?
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-12">
                        <span class="text-muted small text-uppercase fw-semibold d-block">Nome do Produto</span>
                        <span class="fw-bold text-dark">@Model.Produto.Nome</span>
                    </div>

                    <div class="col-md-4">
                        <span class="text-muted small text-uppercase fw-semibold d-block">Categoria</span>
                        <span class="text-secondary">@Model.Produto.Categoria</span>
                    </div>

                    <div class="col-md-4">
                        <span class="text-muted small text-uppercase fw-semibold d-block">Qtd. em Estoque</span>
                        <span class="text-secondary">@Model.Produto.QuantidadeEstoque un.</span>
                    </div>

                    <div class="col-md-4">
                        <span class="text-muted small text-uppercase fw-semibold d-block">Preço Unitário</span>
                        <span class="text-secondary">@Model.Produto.Preco.ToString("C")</span>
                    </div>
                </div>

                <hr class="my-4 text-muted opacity-25">

                <form method="post" class="d-flex justify-content-end gap-2">
                    <input type="hidden" asp-for="Produto.Id" />
                    <a asp-page="./Index" class="btn-mono-secondary">Cancelar</a>
                    <button type="submit" class="btn-mono-primary d-inline-flex align-items-center gap-2">
                        <i class="bi bi-trash"></i> Confirmar Exclusão
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>