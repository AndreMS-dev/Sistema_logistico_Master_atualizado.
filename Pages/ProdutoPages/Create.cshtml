@page
@model Sistema_Logistico.Pages.ProdutoPages.CreateModel
@{
    ViewData["Title"] = "Novo Produto";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            
            <!-- Cabeçalho da Página -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold text-dark mb-1">Cadastrar Produto</h3>
                    <p class="text-muted small mb-0">Preencha os dados abaixo para adicionar um item ao estoque.</p>
                </div>
                <a asp-page="Index" class="btn-mono-secondary d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Voltar para Lista
                </a>
            </div>

            <!-- Card do Formulário -->
            <div class="form-card">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-dark py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="Produto.Nome" class="form-label">Nome do Produto</label>
                            <input asp-for="Produto.Nome" class="form-control" placeholder="Ex: Caixa de Papelão Reforçada" />
                            <span asp-validation-for="Produto.Nome" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Produto.Categoria" class="form-label">Categoria</label>
                            <input asp-for="Produto.Categoria" class="form-control" placeholder="Ex: Embalagens" />
                            <span asp-validation-for="Produto.Categoria" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Produto.QuantidadeEstoque" class="form-label">Qtd. em Estoque</label>
                            <input asp-for="Produto.QuantidadeEstoque" type="number" class="form-control" placeholder="0" />
                            <span asp-validation-for="Produto.QuantidadeEstoque" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Produto.Preco" class="form-label">Preço Unitário</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">R$</span>
                                <input asp-for="Produto.Preco" class="form-control border-start-0" placeholder="0,00" />
                            </div>
                            <span asp-validation-for="Produto.Preco" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4 text-muted opacity-25">

                    <!-- Rodapé de Ações -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="Index" class="btn-mono-secondary">Cancelar</a>
                        <button type="submit" class="btn-mono-primary d-inline-flex align-items-center gap-2">
                            <i class="bi bi-check-lg"></i> Salvar Produto
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}